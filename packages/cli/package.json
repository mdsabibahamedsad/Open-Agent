    "dev": "tsx src/bin/openagent.ts"
  },
  "dependencies": {
    "@openagent/developer-tools": "workspace:*",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
