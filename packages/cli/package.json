{
  "name": "@openagent/cli",
  "version": "1.0.0",
  "description": "Production-grade OpenAgent CLI for extension development and lifecycle management",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openagent": "./bin/openagent.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "prepack": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/bin/openagent.ts",
    "lint": "prettier --check \"src/**/*.{ts,tsx,json}\""
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@openagent/desktop": "workspace:*",
    "@openagent/developer-tools": "workspace:*",
    "@openagent/workflow-engine": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/prompts": "^2.4.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
