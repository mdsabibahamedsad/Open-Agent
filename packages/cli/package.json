{
  "name": "@openagent/cli",
  "version": "1.0.0",
  "description": "Production-grade OpenAgent CLI for extension development and lifecycle management",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openagent": "./dist/bin/openagent.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
