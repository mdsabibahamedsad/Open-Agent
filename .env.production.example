# OpenAgent PRODUCTION environment template — placeholders ONLY.
# Copy to .env (or inject via Docker/Kubernetes secrets) and fill every
# value marked REQUIRED. Never commit the filled file. Never reuse
# development secrets in production.
#
# Startup fails closed: missing/insecure production values refuse to boot
# (see apps/api/src/openagent/main.py and sandbox production_security_check).

# =============================================================================
# Application (REQUIRED)
# =============================================================================
OPENAGENT_ENV=production
LOG_LEVEL=info
API_URL=https://api.example.com
WEB_URL=https://app.example.com

# =============================================================================
# Database — managed PostgreSQL 15+ (REQUIRED)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# Back up before every migration. Never point this at a dev database.
# =============================================================================
DATABASE_URL=postgresql+asyncpg://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/openagent

# =============================================================================
# Redis — managed Redis 7+ with AUTH (REQUIRED)
# Format: redis://[:PASSWORD@]HOST:6379/0
# =============================================================================
REDIS_URL=redis://:REPLACE_ME@REPLACE_ME:6379/0

# =============================================================================
# Bundled-service credentials (REQUIRED only when using
# docker-compose.production.yml for postgres/redis — values MUST match
# DATABASE_URL / REDIS_URL above)
# =============================================================================
POSTGRES_USER=openagent
POSTGRES_PASSWORD=REPLACE_ME_MUST_MATCH_DATABASE_URL
POSTGRES_DB=openagent
REDIS_PASSWORD=REPLACE_ME_MUST_MATCH_REDIS_URL

# =============================================================================
# Security (REQUIRED — generate fresh, 32+ chars enforced at startup)
# Generate with: openssl rand -hex 32
# =============================================================================
SECRET_KEY=REPLACE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ENCRYPTION_KEY=REPLACE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
WORKER_SERVICE_TOKEN=REPLACE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# =============================================================================
# CORS (REQUIRED — exact production origins, no localhost, no wildcards)
# =============================================================================
CORS_ORIGINS=https://app.example.com

# =============================================================================
# Object storage (REQUIRED for artifacts; filesystem is dev-only)
# provider: minio | s3 | r2  (see compose for local MinIO)
# =============================================================================
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=openagent-artifacts
OBJECT_STORAGE_ENDPOINT=REPLACE_ME
OBJECT_STORAGE_REGION=REPLACE_ME
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME
OBJECT_STORAGE_SECRET_KEY=REPLACE_ME

# =============================================================================
# Model providers (OPTIONAL — configure only the ones you use; local Ollama
# needs no key. Never commit keys.)
# =============================================================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# =============================================================================
# Auth / Email (OPTIONAL — required only if email auth enabled)
# =============================================================================
# AUTH_PROVIDER=email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# =============================================================================
# Sandbox (production-safe defaults — do NOT relax without review)
# =============================================================================
SANDBOX_PROVIDER=docker
SANDBOX_NETWORK_MODE=NO_NETWORK
SANDBOX_IMAGE_DIGEST=sha256:REPLACE_ME_PINNED_DIGEST_REQUIRED_IN_PRODUCTION
# SANDBOX_EGRESS_PROXY=http://egress-filter:8080
# SANDBOX_ALLOW_LOCAL_FALLBACK=false

# =============================================================================
# Approvals / Evaluation / Connectors (production fail-closed defaults)
# =============================================================================
APPROVALS_ENABLED=true
DEFAULT_HIGH_RISK_POLICY=REQUIRE_APPROVAL
REQUIRE_APPROVAL_FOR_EXTERNAL_SIDE_EFFECTS=true
REQUIRE_APPROVAL_FOR_PRODUCTION=true
ALLOW_SELF_EVALUATION=false
CONNECTOR_ALLOW_PRIVATE_EGRESS=false
CONNECTOR_REQUIRE_HTTPS=true

# =============================================================================
# Observability (OPTIONAL but recommended)
# =============================================================================
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OPS_ALERT_WEBHOOKS=https://example.com/ops-alerts

# =============================================================================
# Billing (OPTIONAL — leave disabled unless running paid flows)
# BILLING_MODE=disabled | mock | live
# live REQUIRES BILLING_PROVIDER + BILLING_WEBHOOK_SECRET (fails closed)
# =============================================================================
BILLING_MODE=disabled
# BILLING_PROVIDER=
# BILLING_WEBHOOK_SECRET=

# =============================================================================
# MinIO (only if using the bundled object storage service)
# =============================================================================
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
