# OpenAgent Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Application Environment
# =============================================================================
OPENAGENT_ENV=development
LOG_LEVEL=debug

# =============================================================================
# URLs
# =============================================================================
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# =============================================================================
# Database
# =============================================================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://openagent:openagent@localhost:5432/openagent

# =============================================================================
# Redis
# =============================================================================
# Redis connection string
# Format: redis://user:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Security
# =============================================================================
# Secret key for JWT tokens, encryption, etc.
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-min-32-chars

# API key encryption key (for storing provider API keys)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# Authentication (Future - Master Prompt 03/04)
# =============================================================================
# AUTH_PROVIDER=email
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# =============================================================================
# Model Providers (Future - Master Prompt 02+)
# =============================================================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# COHERE_API_KEY=
# MISTRAL_API_KEY=
# HUGGINGFACE_API_KEY=

# =============================================================================
# Observability (Future)
# =============================================================================
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# Sandbox & Secure Execution (Master Prompt 18)
# =============================================================================
# Provider: docker (production) | local (explicit dev-only fallback, refused
# in production unless SANDBOX_ALLOW_LOCAL_FALLBACK=true AND non-production)
SANDBOX_PROVIDER=docker
SANDBOX_DEFAULT_PROFILE=TEST
SANDBOX_DEFAULT_TIMEOUT=300
SANDBOX_MAX_TIMEOUT=3600
SANDBOX_MAX_MEMORY=8192
SANDBOX_MAX_CPU=4
SANDBOX_MAX_DISK=20480
SANDBOX_MAX_PIDS=1024
# Default network posture: NO_NETWORK. Non-NO_NETWORK modes require
# SANDBOX_EGRESS_PROXY (filtered egress) or execution fails closed.
SANDBOX_NETWORK_MODE=NO_NETWORK
# SANDBOX_EGRESS_PROXY=http://egress-filter:8080
SANDBOX_IMAGE=openagent-sandbox-base
# Production requires a pinned digest:
# SANDBOX_IMAGE_DIGEST=sha256:<digest>
# SANDBOX_IMAGE_TRUST=CORE
SANDBOX_CLEANUP_INTERVAL=300
SANDBOX_ARTIFACT_RETENTION=30
# Never enable in production:
# SANDBOX_ALLOW_LOCAL_FALLBACK=false
# =============================================================================
# Human Approval & Guardrails (Master Prompt 19)
# =============================================================================
# Master switch. Refused false in production (startup fails closed).
APPROVALS_ENABLED=true
# Single-use + short expiration by default (seconds).
DEFAULT_APPROVAL_EXPIRATION=14400
MAX_APPROVAL_EXPIRATION=604800
# REQUIRE_APPROVAL or DENY. Never ALLOW.
DEFAULT_HIGH_RISK_POLICY=REQUIRE_APPROVAL
REQUIRE_APPROVAL_FOR_EXTERNAL_SIDE_EFFECTS=true
REQUIRE_APPROVAL_FOR_PRODUCTION=true
ENABLE_MULTI_APPROVAL=true
# Delegation is opt-in (scoped + time-bound, never permanent).
ENABLE_DELEGATION=false
ENABLE_ESCALATION=true
# Emergency override is opt-in and requires an explicit multi-approved runbook.
# Never a master password; the Master Account stays subject to platform policy.
ENABLE_BREAK_GLASS=false
# =============================================================================
# Evaluator, Verification & Self-Correction (Master Prompt 20)
# =============================================================================
EVALUATION_ENABLED=true
DEFAULT_EVALUATION_TIMEOUT=300
MAX_CORRECTION_CYCLES=3
MAX_EVALUATION_RETRIES=2
DEFAULT_QUALITY_THRESHOLD=0.7
DEFAULT_CONFIDENCE_THRESHOLD=0.6
MAX_EVALUATION_COST=5.0
MAX_EVALUATION_TOKENS=50000
ENABLE_LLM_EVALUATION=true
ENABLE_MULTI_EVALUATOR=true
ENABLE_SELF_CORRECTION=true
# CONSERVATIVE_FAIL | HUMAN_REVIEW | SECOND_REVIEW | MORE_EVIDENCE
EVALUATOR_DISAGREEMENT_POLICY=CONSERVATIVE_FAIL
# Never enable silently in production (startup fails closed).
ALLOW_SELF_EVALUATION=false

# =============================================================================
# Universal Integrations & Connectors (Master Prompt 21)
# =============================================================================
CONNECTORS_ENABLED=true
CONNECTOR_DEFAULT_TIMEOUT=30
CONNECTOR_MAX_TIMEOUT=120
CONNECTOR_MAX_PAGES=10
CONNECTOR_MAX_ITEMS=500
CONNECTOR_MAX_BYTES=5242880
# Never enable silently in production (startup fails closed).
CONNECTOR_ALLOW_PRIVATE_EGRESS=false
CONNECTOR_REQUIRE_HTTPS=true
CONNECTOR_WEBHOOK_TOLERANCE_SECONDS=300
CONNECTOR_MAX_WEBHOOK_BYTES=1048576
CONNECTOR_POLL_MIN_INTERVAL=60
CONNECTOR_CIRCUIT_THRESHOLD=5
CONNECTOR_QUOTA_PER_MINUTE=120
# Community connectors and custom code execution are opt-in.
CONNECTOR_ENABLE_COMMUNITY=false
CONNECTOR_ENABLE_CUSTOM_CODE=false
# Comma-separated hosts allowed as OAuth redirect targets (Web URL is implicit).
# OAUTH_REDIRECT_HOSTS=

# =============================================================================
# Cloud Registry, Billing & Creator Monetization (Master Prompt 24)
# =============================================================================
# disabled: self-hosted works, paid flows raise COMMERCE_DISABLED.
# mock: deterministic test provider for local dev (clearly test mode).
# live: requires BILLING_PROVIDER + BILLING_WEBHOOK_SECRET (fails closed).
BILLING_MODE=disabled
# BILLING_PROVIDER=
# BILLING_WEBHOOK_SECRET=
BILLING_WEBHOOK_SKEW_SECONDS=300
BILLING_SUCCESS_URL=http://localhost:3000/settings/billing?status=success
BILLING_CANCEL_URL=http://localhost:3000/settings/billing?status=cancelled
# Default platform fee in basis points (per-marketplace/product overrides win).
PLATFORM_FEE_BPS=0
PAYOUT_MINIMUM_MINOR=0
PAYOUT_SETTLEMENT_DAYS=7
REFUND_HOLD_DAYS=7
# Public registry endpoint (configurable; never hard-coded in code).
# PUBLIC_REGISTRY_URL=

# =============================================================================
# Cloud Runtime, Workers, Queues, Storage & Regions (Master Prompt 25)
# =============================================================================
# self_hosted: local runtime only (cloud APIs return CLOUD_DISABLED).
# cloud: hosted execution via control plane + worker fleet.
# hybrid: local default with cloud burst for entitled orgs.
OPENAGENT_RUNTIME_MODE=self_hosted
OPENAGENT_CLOUD_ENABLED=false
# Feature flags (single canonical list; avoid scattered booleans).
FEATURE_CLOUD_RUNTIME=false
FEATURE_DISTRIBUTED_WORKERS=false
FEATURE_MULTI_REGION=false
FEATURE_AUTOSCALING=false
FEATURE_OBJECT_STORAGE=false
FEATURE_CLOUD_SCHEDULER=false
FEATURE_CLOUD_ARTIFACTS=false
# Internal worker service token (bootstrap secret; per-task credentials
# are minted short-lived at claim time). Generate with: openssl rand -hex 32
# WORKER_SERVICE_TOKEN=
# Object storage baseline: filesystem (dev) | minio | s3 | r2 | fake (tests).
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_BUCKET=openagent-artifacts
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
ARTIFACT_MAX_BYTES=536870912
CLOUD_QUEUE_PROVIDER=redis
CLOUD_QUEUE_MAX_DEPTH=100000
WORKER_HEARTBEAT_SECONDS=30
WORKER_HEARTBEAT_TTL_SECONDS=90
WORKER_LEASE_SECONDS=300
EXECUTION_LEASE_SECONDS=600
AUTOSCALE_MIN_WORKERS=1
AUTOSCALE_MAX_WORKERS=20
AUTOSCALE_COOLDOWN_SECONDS=120
GLOBAL_MAX_WORKERS=100
GLOBAL_MAX_EXECUTIONS=10000
GLOBAL_MAX_QUEUE_DEPTH=100000
GLOBAL_MAX_SANDBOX_COUNT=200
GLOBAL_MAX_BROWSER_COUNT=100
MAX_EXECUTION_SECONDS=3600
MAX_EXECUTIONS_PER_MINUTE_PER_ORG=120
CLOUD_DEFAULT_REGION=local-1
CLOUD_ALLOWED_REGIONS=local-1
SCHEDULER_POLL_SECONDS=15
CLOUD_INCIDENT_MODE=NORMAL
# MinIO (local S3-compatible storage for dev).
# MINIO_ROOT_USER=openagent
# MINIO_ROOT_PASSWORD=openagent-minio-password

# =============================================================================
# Control Plane, Observability and Operations (Master Prompt 26)
# =============================================================================
# All optional: the control plane works self-hosted with defaults.
# OTel exporter (tracing spans export as dicts until configured).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Default alert destinations, comma-separated webhooks (delivery reuses
# the Connector framework; LogNotifier is the always-on fallback).
# OPS_ALERT_WEBHOOKS=
# Platform audit fails safe by default (critical ops blocked if audit
# writes fail). Enable only for non-critical local dev.
# OPS_AUDIT_FAIL_OPEN=false
