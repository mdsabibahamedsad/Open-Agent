# Language variants extend openagent-sandbox-base. Build the base first,
# then: docker build -t openagent-sandbox-python:<version> -f Dockerfile.python .
# Pin the base by digest (BASE_DIGEST) in production builds.

ARG BASE_IMAGE=openagent-sandbox-base:latest
ARG BASE_DIGEST=""

# ---- python ----
FROM ${BASE_IMAGE}${BASE_DIGEST} AS python
USER root
RUN pip install --no-cache-dir mypy==1.* pytest-asyncio==0.* pytest-cov==5.* \
    && rm -rf /root/.cache
USER 65532:65532
WORKDIR /workspace

# ---- node ----
FROM ${BASE_IMAGE}${BASE_DIGEST} AS node
USER root
RUN npm install -g --no-audit --no-fund vitest@1 jest@29 ts-node@10 \
    && rm -rf /root/.npm
USER 65532:65532
WORKDIR /workspace

# ---- go ----
FROM ${BASE_IMAGE}${BASE_DIGEST} AS go
USER root
RUN apt-get update && apt-get install -y --no-install-recommends golang-go \
    && rm -rf /var/lib/apt/lists/*
USER 65532:65532
WORKDIR /workspace

# ---- rust ----
FROM ${BASE_IMAGE}${BASE_DIGEST} AS rust
USER root
RUN apt-get update && apt-get install -y --no-install-recommends cargo rustc \
    && rm -rf /var/lib/apt/lists/*
USER 65532:65532
WORKDIR /workspace

# ---- java ----
FROM ${BASE_IMAGE}${BASE_DIGEST} AS java
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless maven gradle \
    && rm -rf /var/lib/apt/lists/*
USER 65532:65532
WORKDIR /workspace
